# Supabase 설정 (실제 사용시 값 입력)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# 사이트 설정
NEXT_PUBLIC_SITE_URL=https://www.ganpoom.com
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000


# 간판다이렉트(경쟁사) 접수 건수 조회 — 2026-08-27 추가
# theopeningsign/gpdirect 레포의 월별 CSV 를 읽고, '지금 갱신' 버튼이
# 스크래핑 워크플로를 수동 실행할 때 쓴다.
# Fine-grained PAT 권한: gpdirect 에 대해 Contents=Read, Actions=Read and write
# 미설정이어도 대시보드는 정상 동작한다 (다이렉트 카드만 '—' 로 비활성).
GPDIRECT_GITHUB_TOKEN=
# 아래 3개는 기본값이 있어 보통 설정할 필요 없다
# GPDIRECT_REPO=theopeningsign/gpdirect
# GPDIRECT_BRANCH=main
# GPDIRECT_WORKFLOW=scrape_ganpan_csv.yml

# 네이버 검색광고 API — 광고비 자동 입력 (2026-09-11 추가)
# 광고주센터 > 도구 > SA API 사용 관리 에서 발급. 통계 조회에만 쓴다.
NAVER_SA_CUSTOMER_ID=
NAVER_SA_API_KEY=
NAVER_SA_SECRET_KEY=
# /api/adcosts/sync-naver 잠금 키. Vercel Cron 이 Authorization: Bearer 로 자동 첨부한다.
CRON_SECRET=
